// ==============================================================================
// SCHEDULA - HOSPITAL MANAGEMENT SYSTEM (SCHEDULE PROJECT MODULE)
// 5 Core Modules in Order with Complete Essential Details
// 1. User Module         -> users
// 2. Patient Module      -> patients
// 3. Doctor Module       -> doctors
// 4. Availability Module -> doctor_availability
// 5. Appointment Module  -> appointments
// ==============================================================================

Project schedula_hms {
  database_type: 'PostgreSQL'
  Note: '''
    # Schedula - Schedule Project Module
    Complete 5-Module Relational Schema for dbdiagram.io
  '''
}

// ------------------------------------------------------------------------------
// 1. USER MODULE
// ------------------------------------------------------------------------------
Table users {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key']
  email varchar(255) [unique, not null, note: 'Login email']
  phone varchar(20) [unique, note: 'Contact phone for OTP']
  password_hash varchar(255) [note: 'Hashed password (null for Google OAuth)']
  role varchar(20) [not null, note: 'DOCTOR | PATIENT | ADMIN']
  auth_provider varchar(20) [not null, default: 'LOCAL', note: 'LOCAL | GOOGLE']
  is_verified boolean [not null, default: false, note: 'Identity verification status']
  created_at timestamptz [not null, default: `now()`, note: 'Account creation timestamp']
  updated_at timestamptz [not null, default: `now()`, note: 'Account update timestamp']

  Note: 'Central authentication and access control'
}

// ------------------------------------------------------------------------------
// 2. PATIENT MODULE
// ------------------------------------------------------------------------------
Table patients {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key']
  user_id uuid [unique, not null, ref: - users.id, note: '1:1 link to users.id']
  first_name varchar(100) [not null, note: 'Given name']
  last_name varchar(100) [not null, note: 'Family name']
  date_of_birth date [not null, note: 'Birth date']
  gender varchar(20) [not null, note: 'MALE | FEMALE | OTHER']
  blood_group varchar(5) [note: 'Blood group (A+, O+, etc.)']
  emergency_contact varchar(20) [note: 'Emergency contact telephone']
  address text [note: 'Residential address']
  medical_history text [note: 'Allergies, chronic conditions, and clinical notes']
  created_at timestamptz [not null, default: `now()`, note: 'Registration timestamp']

  Note: 'Patient clinical demographics and medical profile'
}

// ------------------------------------------------------------------------------
// 3. DOCTOR MODULE
// ------------------------------------------------------------------------------
Table doctors {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key']
  user_id uuid [unique, not null, ref: - users.id, note: '1:1 link to users.id']
  first_name varchar(100) [not null, note: 'Given name']
  last_name varchar(100) [not null, note: 'Family name']
  specialization varchar(100) [not null, note: 'Medical specialty (e.g. Cardiology, Pediatrics)']
  license_number varchar(50) [unique, not null, note: 'Medical council license registration']
  experience_years int [not null, default: 0, note: 'Years of medical practice']
  consultation_fee decimal(10,2) [not null, default: 0.00, note: 'Fee charged per appointment']
  bio text [note: 'Professional bio and credentials summary']
  rating_average decimal(3,2) [not null, default: 0.00, note: 'Average patient feedback (0.0 - 5.0)']
  is_approved boolean [not null, default: false, note: 'Hospital administrator approval flag']
  created_at timestamptz [not null, default: `now()`, note: 'Onboarding timestamp']

  Note: 'Doctor professional credentials, verified licenses, and fees'
}

// ------------------------------------------------------------------------------
// 4. AVAILABILITY MODULE
// ------------------------------------------------------------------------------
Table doctor_availability {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key']
  doctor_id uuid [not null, ref: > doctors.id, note: 'FK to doctors.id']
  day_of_week varchar(20) [not null, note: 'Day (MONDAY, TUESDAY, etc.)']
  start_time time [not null, note: 'Shift start time']
  end_time time [not null, note: 'Shift end time']
  slot_duration_minutes int [not null, default: 30, note: 'Standard consultation length (min)']
  max_capacity int [not null, default: 1, note: 'Maximum concurrent bookings (Elastic scheduling)']
  is_active boolean [not null, default: true, note: 'Active availability toggle']
  created_at timestamptz [not null, default: `now()`, note: 'Created timestamp']

  Note: 'Weekly recurring consultation schedules and elastic capacity rules'
}

// ------------------------------------------------------------------------------
// 5. APPOINTMENT MODULE
// ------------------------------------------------------------------------------
Table appointments {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key']
  patient_id uuid [not null, ref: > patients.id, note: 'FK to patients.id']
  doctor_id uuid [not null, ref: > doctors.id, note: 'FK to doctors.id']
  appointment_date date [not null, note: 'Scheduled consultation date']
  start_time time [not null, note: 'Scheduled start time']
  end_time time [not null, note: 'Scheduled end time']
  status varchar(30) [not null, default: 'SCHEDULED', note: 'SCHEDULED | CONFIRMED | COMPLETED | CANCELLED | RESCHEDULED']
  reason text [note: 'Patient symptoms and chief complaint']
  cancellation_reason text [note: 'Reason if appointment is cancelled']
  reschedule_reason text [note: 'Reason if appointment was rescheduled']
  created_at timestamptz [not null, default: `now()`, note: 'Booking creation timestamp']
  updated_at timestamptz [not null, default: `now()`, note: 'Last status update timestamp']

  Note: 'Core consultation booking transaction and lifecycle management'
}
