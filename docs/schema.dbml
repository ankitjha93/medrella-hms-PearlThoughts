// ==============================================================================
// SCHEDULA - SIMPLE & CLEAR ER DIAGRAM (SCHEDULE PROJECT MODULE)
// 5 Core Modules in Order:
// 1. User Module -> users
// 2. Patient Module -> patients
// 3. Doctor Module -> doctors
// 4. Availability Module -> doctor_availability
// 5. Appointment Module -> appointments
// ==============================================================================

Project schedula_simple {
  database_type: 'PostgreSQL'
  Note: 'Simple, clear, and easy to understand Schedule Module ER Diagram'
}

// 1. USER MODULE
Table users {
  id uuid [pk]
  email varchar [unique, not null]
  password varchar [not null]
  role varchar [not null, note: 'DOCTOR | PATIENT']
}

// 2. PATIENT MODULE
Table patients {
  id uuid [pk]
  user_id uuid [unique, not null, ref: - users.id]
  name varchar [not null]
  phone varchar
  gender varchar
  date_of_birth date
}

// 3. DOCTOR MODULE
Table doctors {
  id uuid [pk]
  user_id uuid [unique, not null, ref: - users.id]
  name varchar [not null]
  specialization varchar [not null]
  consultation_fee decimal [not null]
}

// 4. AVAILABILITY MODULE
Table doctor_availability {
  id uuid [pk]
  doctor_id uuid [not null, ref: > doctors.id]
  day_of_week varchar [not null, note: 'Monday, Tuesday, etc.']
  start_time time [not null]
  end_time time [not null]
  is_available boolean [default: true]
}

// 5. APPOINTMENT MODULE
Table appointments {
  id uuid [pk]
  patient_id uuid [not null, ref: > patients.id]
  doctor_id uuid [not null, ref: > doctors.id]
  appointment_date date [not null]
  time_slot time [not null]
  status varchar [not null, default: 'CONFIRMED', note: 'CONFIRMED | CANCELLED | RESCHEDULED']
}
