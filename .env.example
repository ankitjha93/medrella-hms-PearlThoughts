# Medrella Environment Configuration
# Copy this file to .env.local if you wish to override default port or serverless settings.
# Note: Zero environment variables are required for standard local dev or Vercel deployment.

# Port for local dev server (default: 3000)
PORT=3000

# Next.js telemetry (optional)
NEXT_TELEMETRY_DISABLED=1

# Vercel deployment indicator (automatically provided by Vercel environment)
# VERCEL=1

